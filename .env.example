# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///./data/search_engine.db

# ── Crawler (Phase 10) ──────────────────────────────────────
CRAWLER_USER_AGENT=SearchEngineBot/0.1
CRAWLER_TIMEOUT=10
CRAWLER_DELAY=1.0
MAX_CRAWL_PAGES=100
MAX_CRAWL_DEPTH=2

# ── Ranking (Phase 7) ───────────────────────────────────────
BM25_K1=1.2
BM25_B=0.75

# ── Index (Phase 4) ─────────────────────────────────────────
# INDEX_PATH=./data/index

# ── Semantic search (Phase 14) ────────────────────────────────
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
VECTOR_INDEX_PATH=./data/vector_index
VECTOR_INDEX_VERSION=1

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
